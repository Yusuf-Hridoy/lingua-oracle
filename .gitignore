.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
reports/*
!reports/.gitkeep
tests/fixtures/*.pdf
tests/fixtures/.build-stamp.json
dist/
build/
*.egg-info/
.DS_Store

# data/sources/ holds the official regulation PDFs and HTML the answer keys are
# built from. They are published documents anyone can download from the
# publisher, and a hundred megabytes of them in every clone, forever, is not a
# good trade for provenance that data/sources/README.md records just as well.
# The README stays tracked; the documents do not. Real SDS / product documents
# must NOT go here either.
data/sources/**
!data/sources/README.md

# Real SDS and label PDFs used for validation are COMPANY DATA. Everything in
# this directory stays local: the PDFs themselves and the case, triage and
# spot-check files, which quote product names. Only cases.example.yaml is
# tracked, and it is kept outside this directory.
data/validation/

# PubChem's classifications for the ingredients of the documents checked
# (lingua keys pubchem): reference data, kept locally - the CAS numbers in it
# are those documents' compositions.
data/reference_classifications/*
!data/reference_classifications/README.md
