<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lingua Oracle</title>
<style>
  :root { --bg:#f7f7f8; --card:#fff; --ink:#1b1b1f; --muted:#5f6368; --line:#e2e3e7;
          --accent:#0b5cad; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
         font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
  .wrap { max-width:720px; margin:0 auto; padding:48px 20px 80px; }
  h1 { font-size:24px; margin:0 0 6px; }
  p.sub { color:var(--muted); margin:0 0 28px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:12px;
          padding:24px; margin-bottom:20px; }
  label { display:block; font-size:13px; font-weight:600; margin:0 0 6px; }
  .row { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:18px; }
  select, input[type=file] { width:100%; padding:9px 10px; border:1px solid var(--line);
          border-radius:8px; background:#fff; font-size:14px; }
  .drop { border:2px dashed var(--line); border-radius:10px; padding:28px;
          text-align:center; color:var(--muted); background:#fcfcfd; }
  .drop.over { border-color:var(--accent); background:#eef5fd; color:var(--accent); }
  .drop input { margin-top:12px; }
  button { margin-top:20px; width:100%; padding:11px 16px; border:0; border-radius:8px;
           background:var(--accent); color:#fff; font-size:15px; font-weight:600;
           cursor:pointer; }
  button:hover { background:#094a8c; }
  .hint { font-size:12px; color:var(--muted); margin-top:10px; }
  h2 { font-size:16px; margin:0 0 4px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Lingua Oracle</h1>
  <p class="sub">Check an SDS or label PDF against the official wording for its regulation and language.</p>

  <form class="card" method="post" action="/check/html" enctype="multipart/form-data">
    <h2>Check one document</h2>
    <div class="drop" id="drop">
      Drop a PDF here, or choose a file
      <input type="file" name="file" accept="application/pdf" required>
    </div>
    <div class="row">
      <div>
        <label for="regulation">Regulation</label>
        <select id="regulation" name="regulation">
          <option value="">Detect automatically</option>
          {% for rid, name in regulations %}<option value="{{ rid }}">{{ name }}</option>{% endfor %}
        </select>
      </div>
      <div>
        <label for="language">Language</label>
        <select id="language" name="language">
          <option value="">Detect automatically</option>
          {% for tag in languages %}<option value="{{ tag }}">{{ tag }}</option>{% endfor %}
        </select>
      </div>
    </div>
    <button type="submit">Check document</button>
    <p class="hint">Leave both on &ldquo;detect automatically&rdquo; and the regulation is read from the document text. If it cannot be determined, you are asked to choose rather than given a guess.</p>
  </form>

  <form class="card" method="post" action="/compare" enctype="multipart/form-data">
    <h2>Compare two documents</h2>
    <div class="row">
      <div><label for="a">Document A</label><input id="a" type="file" name="file_a" accept="application/pdf" required></div>
      <div><label for="b">Document B</label><input id="b" type="file" name="file_b" accept="application/pdf" required></div>
    </div>
    <div class="row">
      <div>
        <label for="creg">Regulation</label>
        <select id="creg" name="regulation">
          <option value="">Detect automatically</option>
          {% for rid, name in regulations %}<option value="{{ rid }}">{{ name }}</option>{% endfor %}
        </select>
      </div>
      <div>
        <label for="clang">Language</label>
        <select id="clang" name="language">
          <option value="">Detect automatically</option>
          {% for tag in languages %}<option value="{{ tag }}">{{ tag }}</option>{% endfor %}
        </select>
      </div>
    </div>
    <button type="submit">Compare documents</button>
  </form>
</div>
<script>
  const drop = document.getElementById('drop');
  const input = drop.querySelector('input[type=file]');
  ['dragenter','dragover'].forEach(e => drop.addEventListener(e, ev => {
    ev.preventDefault(); drop.classList.add('over');
  }));
  ['dragleave','drop'].forEach(e => drop.addEventListener(e, ev => {
    ev.preventDefault(); drop.classList.remove('over');
  }));
  drop.addEventListener('drop', ev => { input.files = ev.dataTransfer.files; });
</script>
</body>
</html>
