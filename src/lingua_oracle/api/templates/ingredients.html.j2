<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lingua Oracle &ndash; Ingredients</title>
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
<div class="topbar">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="17" height="17" rx="4" stroke="#1F4FB8" stroke-width="1.6"/>
        <path d="M5.8 10.2l2.7 2.7 5.7-5.7" stroke="#1F4FB8" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Lingua Oracle
    </a>
    <nav class="nav">
      <a href="/">Check</a>
      <a href="/ingredients" aria-current="page">Ingredients</a>
      <a href="/history">History</a>
      <a href="/coverage">Coverage</a>
    </nav>
  </div>
</div>

<div class="wrap page">
  <h1>Ingredient check</h1>
  <p class="lede">Every ingredient's hazard codes against the harmonised
    classification in CLP Annex VI Table 3. Reads from ExactSDS and changes
    nothing there.</p>

  {% if error %}<div class="verdict v-fix"><div class="banner">
    <span class="vico" aria-hidden="true">&#10005;</span>
    <div><h2>Could not run</h2><p>{{ error }}</p></div></div></div>{% endif %}

  <form class="card run-form" method="post" action="/ingredients/run">
    <fieldset>
      <legend>What to check</legend>
      <label class="choice">
        <input type="radio" name="scope" value="product" checked>
        One product
      </label>
      <div class="field">
        <label for="product-search"><span>Search by name</span></label>
        <input id="product-search" name="product_name" type="search"
               autocomplete="off" role="combobox" aria-expanded="false"
               aria-controls="product-matches"
               placeholder="start typing a product name"
               value="{{ query }}">
        <input type="hidden" name="product_id" id="product-id" value="">
        <ul id="product-matches" class="matches" role="listbox" hidden></ul>
        <p class="note chosen" id="chosen" hidden></p>
      </div>
      <label class="choice">
        <input type="radio" name="scope" value="library">
        The whole library <span class="muted">(reads every product; takes a while)</span>
      </label>
    </fieldset>
    <button type="submit" class="primary">Run check</button>
  </form>

  {% if runs %}
  <h2 class="section">Previous runs</h2>
  <table class="recent">
    <thead><tr><th>Run</th><th>Checked against</th><th>Result</th><th>Started</th></tr></thead>
    <tbody>
      {% for row in runs %}
      <tr>
        <td><a href="/ingredients/runs/{{ row.id }}">{{ row.file_name }}</a></td>
        <td>{{ row.regulation }}</td>
        <td><span class="pill {{ row.pill }}">{{ row.release }}</span></td>
        <td class="muted">{{ row.created_at[:16].replace('T', ' ') }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
<script>
  // Typeahead over /ingredients/search. A name is only useful once it points at
  // one product, so the hidden id is what the form submits and it is cleared
  // whenever the text changes - no stale id can be sent with a new name.
  const box = document.getElementById('product-search');
  const list = document.getElementById('product-matches');
  const idField = document.getElementById('product-id');
  const chosen = document.getElementById('chosen');
  let timer = null;

  function clearChoice() {
    idField.value = '';
    chosen.hidden = true;
    chosen.textContent = '';
  }

  function show(results) {
    list.innerHTML = '';
    if (!results.length) { list.hidden = true; box.setAttribute('aria-expanded', 'false'); return; }
    for (const row of results) {
      const item = document.createElement('li');
      item.setAttribute('role', 'option');
      item.tabIndex = 0;
      item.dataset.id = row.id;
      item.textContent = row.name + ' (' + row.id + ')';
      const pick = () => {
        idField.value = row.id;
        box.value = row.name;
        chosen.textContent = 'Checking ' + row.name + ' (' + row.id + ')';
        chosen.hidden = false;
        list.hidden = true;
        box.setAttribute('aria-expanded', 'false');
      };
      item.addEventListener('click', pick);
      item.addEventListener('keydown', e => { if (e.key === 'Enter') pick(); });
      list.appendChild(item);
    }
    list.hidden = false;
    box.setAttribute('aria-expanded', 'true');
  }

  box.addEventListener('input', () => {
    clearChoice();
    clearTimeout(timer);
    const q = box.value.trim();
    if (q.length < 2) { show([]); return; }
    timer = setTimeout(async () => {
      const res = await fetch('/ingredients/search?q=' + encodeURIComponent(q));
      const data = await res.json();
      show(data.results || []);
    }, 200);
  });
</script>
</body>
</html>
