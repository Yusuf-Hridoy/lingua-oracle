{% import '_substances.html.j2' as sub %}
{% import '_mixture.html.j2' as mix %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lingua Oracle - {{ report.file_name }}</title>
{# The stylesheet is inlined rather than linked: a saved report is passed
   around as a single file and has to render with no network. #}
<style>{{ app_css }}</style>
</head>
<body>

<div class="topbar">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="17" height="17" rx="4" stroke="#1F4FB8" stroke-width="1.6"/>
        <path d="M5.8 10.2l2.7 2.7 5.7-5.7" stroke="#1F4FB8" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Lingua Oracle
    </a>
    <nav class="nav">
      <a href="/" aria-current="page">Check</a>
      <a href="/ingredients">Ingredients</a>
      <a href="/history">History</a>
      <a href="/coverage">Coverage</a>
    </nav>
  </div>
</div>

<div class="wrap page">
  <a class="back" href="/">&larr; Check another document</a>

  <div class="report-head">
    <div>
      <h1>{{ report.file_name }}</h1>
      {% if ing and ing.product_id %}
      <p class="matched">Matched to ExactSDS product:
        <b>{{ ing.product_name }}</b> ({{ ing.product_id }})
        <a class="change" href="/ingredients?q={{ ing.product_name | urlencode }}">Not this product?</a>
      </p>
      {% elif ing and ing.match_state == 'ambiguous' %}
      <p class="matched">Several ExactSDS products could be this sheet.
        <a class="change" href="/ingredients?q={{ ing.evidence | urlencode }}">Choose one</a>
      </p>
      {% endif %}
      <div class="meta">
        <span>{{ regulation_display }}</span>
        <span>{{ language_name }}</span>
        <span>Regulation {{ set_by }}</span>
        <span>Checked {{ report.created_at.strftime('%-d %b %Y, %H:%M') }}</span>
        {% if report.compared_with %}<span>compared with {{ report.compared_with }}</span>{% endif %}
      </div>
    </div>
    <div class="head-actions">
      <button type="button" onclick="window.print()">Download PDF</button>
      <button type="button" class="copy" data-text="">Copy link</button>
    </div>
  </div>

  {% if ing and ing.candidates %}
  {# Above the verdict, because the verdict is incomplete until it is answered. #}
  <form class="card picker" method="post" action="/reports/{{ report.id }}/product">
    <h2>Which product is this?</h2>
    <p class="note">{{ ing.candidates|length }} products in ExactSDS could be
      this sheet. The ingredient and mixture checks need to know which.</p>
    <ul class="candidates">
      {% for c in ing.candidates %}
      <li>
        <label>
          <input type="radio" name="product_id" value="{{ c.product_id }}"
                 {% if loop.first %}checked{% endif %}>
          <span class="who">{{ c.name }}</span>
          <span class="muted">id {{ c.product_id }}{% if c.regulation %}
            &middot; {{ regulation_name(c.regulation) }}{% endif %}</span>
        </label>
      </li>
      {% endfor %}
    </ul>
    <button type="submit" class="primary">Check this product</button>
  </form>
  {% endif %}

  <div class="verdict v-{{ verdict.tone }}">
    <div class="banner">
      <span class="vico" aria-hidden="true">{{ verdict.icon }}</span>
      <div>
        <h2>{{ verdict.release }}</h2>
        <p>{{ verdict.detail }}</p>
      </div>
    </div>
    <div class="stats">
      <div><div class="n fix">{{ cards.counts.wrong }}</div><div class="l">Wrong wording</div></div>
      <div><div class="n fix">{{ cards.counts.fix }}</div><div class="l">Fix this</div></div>
      <div><div class="n check">{{ cards.counts.check }}</div><div class="l">Check this</div></div>
      <div><div class="n ok">{{ cards.counts.correct }}</div><div class="l">Correct</div></div>
      <div><div class="n">{{ coverage_percent }}%</div>
           <div class="l">Codes checked ({{ report.coverage.codes_checked }} of {{ report.coverage.codes_found }})</div></div>
    </div>
  </div>

  {% if verdict.actions %}
  <div class="card todo">
    <h2>What to do</h2>
    <ol>
      {% for text, count in verdict.actions %}
      <li>{{ text }}{% if count > 1 %} <span class="muted">({{ count }} places)</span>{% endif %}</li>
      {% endfor %}
    </ol>
  </div>
  {% endif %}

  <div class="issues-head">
    <h2>Wording &middot; {{ cards.problems|length }}</h2>
    <span class="status s-{{ status_tone[wording_status[0]] }}">{{ wording_status[0] }}
      &mdash; {{ wording_status[1] }}</span>
    <div class="filters" role="group" aria-label="Filter issues">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="must" aria-pressed="false">Must fix</button>
      <button type="button" data-filter="check" aria-pressed="false">To check</button>
    </div>
  </div>

  {% for row in cards.problems %}
  <article class="issue" data-section="wording" data-status="{{ row.status }}">
    <header>
      <span class="pill {{ row.label.css }}"><span aria-hidden="true">{{ row.label.icon }}</span> {{ row.label.word }}</span>
      <span class="code">{{ L.code_label(row.v.code if row.v else row.finding.code) or "This document" }}</span>
      {% set sec = (row.v.section if row.v else row.finding.section) %}
      {% set pg = (row.v.page if row.v else row.finding.page) %}
      {% if sec %}<span class="where">{{ L.section_label(sec) }}{% if pg %} &middot; page {{ pg }}{% endif %}</span>{% endif %}
    </header>

    <div class="body{% if row.single %} single{% endif %}">
      <div class="side">
        <h3>Your document</h3>
        <div class="txt">{% if row.v %}{{ row.found_html | safe }}{% else %}{{ row.finding.found or row.finding.message }}{% endif %}</div>
        {% if row.instruction %}<p class="note instruct">{{ row.instruction }}</p>{% endif %}
        {% if row.reference %}
        <p class="reference"><span>Official wording:</span> {{ row.reference }}
          <span class="muted">(the &lsquo;&hellip;&rsquo; is the blank to fill in)</span></p>
        {% endif %}
        {% if row.match_note %}<p class="note">{{ row.match_note }}</p>{% endif %}
        {% if row.v %}{% for value in row.v.fillins %}
        <p class="note" style="color:var(--accent)">You filled in:
          <mark class="fillin">{{ value }}</mark> &mdash; check it fits this product.</p>
        {% endfor %}{% endif %}
      </div>
      {% if not row.single %}
      <div class="side official">
        <header>
          <h3>{{ row.official_heading }}</h3>
          <button type="button" class="copy" data-text="{{ row.v.expected }}">Copy</button>
        </header>
        <div class="txt">{{ row.expected_html | safe }}</div>
      </div>
      {% endif %}
    </div>

    <footer>
      <span>{% if row.v %}{{ row.v.why }}{% endif %}{% if row.action %} {{ row.action }}{% endif %}</span>
      {% if row.v and row.v.source %}<span class="src">Source: {{ row.v.source }}</span>{% endif %}
    </footer>
  </article>
  {% endfor %}

  {% if cards.minor %}
  {# Same words, different punctuation or capital letters. One card for all of
     them: each is worth recording and none is worth the space a card takes. #}
  <details class="block minor">
    <summary>{{ cards.minor|length }} statement{{ '' if cards.minor|length == 1 else 's' }}
      differ{{ 's' if cards.minor|length == 1 else '' }} only in punctuation or capital letters</summary>
    <div class="inner">
      <p class="note">The words are the official words. Align them if you are
        editing anyway, or confirm the difference does not matter.</p>
      <table class="minor-table">
        <thead>
          <tr><th>Code</th><th>Your document</th><th>Official wording</th></tr>
        </thead>
        <tbody>
          {% for row in cards.minor %}
          <tr>
            <td class="code">{{ L.code_label(row.v.code) }}</td>
            <td>{{ row.v.found }}</td>
            <td>{{ row.v.expected }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
  {% endif %}

  {% if cards.correct %}
  <details class="block good">
    <summary>{{ cards.correct|length }} statement{{ '' if cards.correct|length == 1 else 's' }} match the official wording</summary>
    <div class="inner">
      <ul class="statements">
        {% for row in cards.correct %}
        <li><span class="code">{{ row.v.code }}</span>
          <span>{{ row.v.found }}{% if row.v.match_note %}
            <em class="note-inline">{{ row.v.match_note }}</em>{% endif %}</span></li>
        {% endfor %}
      </ul>
    </div>
  </details>
  {% endif %}

  {# All three sections are always on the page. A section with nothing to say
     says that, in a line: a reader should never have to work out whether a
     check was clean or never ran. #}
  <div class="issues-head" id="ingredients">
    <h2>Ingredients &middot;
      {{ ing.counts.get('substances', 0) if ing and ing.counts else 0 }}</h2>
    <span class="status s-{{ status_tone[ingredient_status[0]] }}">{{ ingredient_status[0] }}
      &mdash; {{ ingredient_status[1] }}</span>
  </div>

  {% if ing and ing.counts and ing.counts.get('substances') %}
  <div class="verdict v-{{ ing_tone }} compact">
    <div class="stats">
      <div><div class="n fix">{{ ing.counts.fix }}</div><div class="l">Under-classified</div></div>
      <div><div class="n check">{{ ing.counts.inconsistent_substances }}</div><div class="l">Inconsistent codes</div></div>
      <div><div class="n ok">{{ ing.counts.ok }}</div><div class="l">Matches Annex VI</div></div>
      <div><div class="n">{{ ing.counts.not_checked }}</div><div class="l">Not checked</div></div>
    </div>
  </div>
  {% for s in ing_under %}{{ sub.under_card(s, ing_said_by, ing_list) }}{% endfor %}
  {% for s in ing_inconsistent %}{{ sub.inconsistent_card(s, ing_said_by) }}{% endfor %}
  {{ sub.upcoming(ing.substances) }}
  {{ sub.collapsed(ing_matches, ing_extra, ing_unchecked, ing_reasons) }}
  {% endif %}

  <div class="issues-head" id="mixture">
    <h2>Mixture &middot; {{ mixture.results|length if mixture else 0 }}</h2>
    <span class="status s-{{ status_tone[mixture_status[0]] }}">{{ mixture_status[0] }}
      &mdash; {{ mixture_status[1] }}</span>
  </div>

  {% if mixture and mixture.state == 'calculated' %}
  {{ mix.banner(mixture) }}
  <div class="verdict v-{{ mixture_tone }} compact">
    <div class="stats">
      <div><div class="n fix">{{ mixture.counts.inconsistent }}</div><div class="l">Inconsistent</div></div>
      <div><div class="n check">{{ mixture.counts.cannot_tell }}</div><div class="l">Can&rsquo;t tell</div></div>
      <div><div class="n ok">{{ mixture.counts.consistent }}</div><div class="l">Consistent</div></div>
      <div><div class="n">{{ mixture.counts.not_calculated }}</div><div class="l">Not calculated</div></div>
      <div><div class="n">{{ mixture.declared_total }}%</div>
           <div class="l">Declared ({{ mixture.undisclosed }}% not disclosed)</div></div>
    </div>
  </div>
  {% for r in mixture.results %}{{ mix.card(r) }}{% endfor %}
  {% if mixture.upcoming %}
  <details class="block upcoming" open>
    <summary>Changes coming to Annex VI &middot; {{ mixture.upcoming|length }}</summary>
    <div class="inner"><ul class="statements">
      {% for note in mixture.upcoming %}<li><span>{{ note }}</span></li>{% endfor %}
    </ul></div>
  </details>
  {% endif %}
  {% endif %}

  <details class="block">
    <summary>Not checked ({{ cards.unchecked|length }}) and technical details</summary>
    <div class="inner">
      {% if cards.unchecked %}
      <ul class="statements">
        {% for row in cards.unchecked %}
        <li><span class="code">{{ row.v.code }}</span><span>{{ row.v.why }}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
      <dl class="tech">
        {% for line in verdict.caveats %}<dt>&nbsp;</dt><dd>{{ line }}</dd>{% endfor %}
        <dt>{{ L.META.file }}</dt><dd>{{ report.file_name }}</dd>
        <dt>{{ L.META.regulation }}</dt><dd>{{ regulation_display }}</dd>
        <dt>{{ L.META.language }}</dt><dd>{{ report.language }}</dd>
        <dt>{{ L.META.set_by }}</dt><dd>{{ set_by }}</dd>
        <dt>{{ L.META.id }}</dt><dd>{{ report.id }}</dd>
        {% if report.sources %}
        <dt>Sources used</dt>
        <dd class="sources">{% for line in report.sources %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>
        {% endif %}
        {% for note in report.notes %}<dt>&nbsp;</dt><dd>{{ note }}</dd>{% endfor %}
        <dt>Checks that reported</dt>
        <dd>{% for cid in report.findings|map(attribute='check_id')|unique|sort %}{{ cid }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
        {% if cards.provenance %}
        <dt>Where each wording came from</dt>
        <dd>{% for code, detail in cards.provenance %}<b>{{ code }}</b>: {{ detail }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>
        {% endif %}
        {% if ing_anomalies %}
        <dt>Anomalies in the list itself</dt>
        <dd>{% for line in ing_anomalies %}{{ line }}<br>{% endfor %}</dd>
        {% endif %}
        {% if ing and ing.list_title %}
        <dt>Ingredients measured against</dt>
        <dd>{{ ing.list_title }} &mdash;
          {{ 'binding' if ing.list_binding else 'reference only' }}.
          {{ ing.list_authority }}</dd>
        {% endif %}
        {% if mixture and mixture.results %}{{ mix.trace(mixture.results) }}{% endif %}
        {% if mixture and mixture.assumptions %}
        <dt>Mixture assumptions</dt>
        <dd>{% for a in mixture.assumptions %}{{ a }}<br>{% endfor %}</dd>
        {% endif %}
        <dt>Source of official text</dt>
        <dd>{% for tier, label in L.SOURCE.items() %}<b>{{ label.word }}</b>: {{ label.help }} {% endfor %}</dd>
      </dl>
    </div>
  </details>
</div>

<script>
  document.addEventListener('click', function (event) {
    const copy = event.target.closest('button.copy');
    if (copy) {
      const text = copy.dataset.text || window.location.href;
      const done = () => {
        const was = copy.textContent;
        copy.textContent = 'Copied';
        setTimeout(() => { copy.textContent = was; }, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, done);
      } else {
        const area = document.createElement('textarea');
        area.value = text; document.body.appendChild(area); area.select();
        try { document.execCommand('copy'); } catch (e) {}
        area.remove(); done();
      }
      return;
    }
    const filter = event.target.closest('.filters button');
    if (!filter) return;
    const want = filter.dataset.filter;
    document.querySelectorAll('.filters button').forEach(b =>
      b.setAttribute('aria-pressed', String(b === filter)));
    // Only the wording cards. The filters live in that section's header and
    // must not reach into the Ingredients section below it.
    document.querySelectorAll('.issue[data-section="wording"]').forEach(card => {
      const status = card.dataset.status;
      const show = want === 'all'
        || (want === 'must' && (status === 'wrong' || status === 'fix'))
        || (want === 'check' && status === 'check');
      card.hidden = !show;
    });
  });
</script>
</body>
</html>
