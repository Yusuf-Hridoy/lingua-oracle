{% import '_mixture.html.j2' as mix %}
{% macro pill(status) %}{% set p = PILL[status] %}{% if p[0] %}<span class="pill {{ p[2] }}"><span aria-hidden="true">{{ p[1] }}</span> {{ p[0] }}</span>{% else %}<span></span>{% endif %}{% endmacro %}
{% macro ate_lines(m) %}
{% for line in m.trace if 'ATEmix =' in line and '\u2192' in line %}<span class="rnote ate">{{ line }}</span>{% endfor %}
{% endmacro %}
{% macro mixture_row(r) %}
{% set m = r.mixture %}
{% set acute = (m.family or '').startswith('Acute toxicity') %}
{% if m.verdict == 'not_calculated' and not m.calculated_class %}
  <span class="val">{{ m.message }}</span>
{% elif not r.problem %}
  <span class="val">Section 2 says {{ m.stated_class or 'nothing' }}; calculated from
    declared ingredients: {{ m.calculated_class or 'no classification' }}.
    <span class="rnote">{{ m.message }}</span>{% if acute %}{{ ate_lines(m) }}{% endif %}</span>
{% else %}
  <div class="cmp">
    <div>
      <div class="sub">Section 2 says</div>
      <div class="txt">{{ m.stated_class or 'Section 2 does not list this hazard' }}</div>
      {% if m.implied_from %}<p class="rnote">{{ m.implied_from }}</p>{% endif %}
    </div>
    <div class="official">
      <div class="sub">Calculated from declared ingredients</div>
      <div class="txt">{% if m.calculated_class %}{{ m.calculated_class }}{% else %}The declared ingredients don&rsquo;t give this hazard{% endif %}</div>
      {% if m.calculated_low and m.calculated_high and m.calculated_low != m.calculated_high %}
      <p class="rnote">{{ m.calculated_low }} at the low end of the declared ranges,
        {{ m.calculated_high }} at the high end.</p>
      {% endif %}
    </div>
    {% if m.contributions %}
    <div class="table-box contributions">
      <table class="ingredients">
        {% if acute %}
        <thead><tr><th>Ingredient</th><th>%</th><th>ATE</th><th>Taken from</th></tr></thead>
        {% else %}
        <thead><tr><th>Ingredient</th><th>%</th><th>Classified</th><th>Counted as</th></tr></thead>
        {% endif %}
        <tbody>
          {% for c in m.contributions %}
          <tr><td>{{ c.name or c.cas or 'unnamed' }}</td><td>{{ c.percentage }} %</td>
            <td>{{ c.hazard_class }}</td>
            <td>{{ c.contributed }}{% if not acute %} %{% endif %}{% if c.note %} <span class="muted">({{ c.note }})</span>{% endif %}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if acute %}<div class="ate-box">{{ ate_lines(m) }}</div>{% endif %}
    <p class="rnote">{{ m.message }}{% if m.citation %} &middot; {{ m.citation }}{% endif %}</p>
    {% if m.justification %}
    <div class="justify">
      <div class="sub">What the sheet gives as its basis</div>
      {% for line in m.justification %}<q>{{ line }}</q>{% endfor %}
    </div>
    {% endif %}
  </div>
{% endif %}
{% endmacro %}
{% macro row(r) %}
<div class="srow{% if r.problem %} problem{% endif %} st-{{ r.status }}" data-status="{{ r.status }}"{% if r.mixture %} data-section="mixture" data-class="{{ r.key }}"{% endif %}>
  <span class="key{% if r.mono %} mono{% endif %}">{{ r.key }}</span>
  {{ pill(r.status) }}
  {% if r.mixture %}{{ mixture_row(r) }}
  {% elif r.compare %}
  <div class="cmp{% if r.single %} single{% endif %}">
    <div>
      <div class="sub">Your document</div>
      <div class="txt">{{ r.found_html | safe }}</div>
    </div>
    {% if not r.single %}
    <div class="official">
      <div class="sub">{{ r.official_heading }}
        <button type="button" class="copy" data-text="{{ r.expected }}">Copy</button></div>
      <div class="txt">{{ r.expected_html | safe }}</div>
    </div>
    {% endif %}
    {% if r.reference %}
    <p class="rnote reference"><span>Official wording:</span> {{ r.reference }}
      <span class="muted">(the &lsquo;&hellip;&rsquo; is the blank to fill in)</span></p>
    {% endif %}
    {% if r.note %}<p class="rnote">{{ r.note }}</p>{% endif %}
    {% for value in r.fillins %}<p class="rnote fill">You filled in:
      <mark class="fillin">{{ value }}</mark> &mdash; check it fits this product.</p>{% endfor %}
    {% if r.source %}<p class="rnote src">Source: {{ r.source }}</p>{% endif %}
  </div>
  {% else %}
  <span class="val">{{ r.text }}{% if r.note %}<span class="rnote">{{ r.note }}</span>{% endif %}
    {% for value in r.fillins %}<span class="rnote fill">You filled in:
      <mark class="fillin">{{ value }}</mark> &mdash; check it fits this product.</span>{% endfor %}</span>
  {% endif %}
</div>
{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lingua Oracle - {{ report.file_name }}</title>
{# The stylesheet is inlined rather than linked: a saved report is passed
   around as a single file and has to render with no network. #}
<style>{{ app_css }}</style>
</head>
<body>

<div class="topbar">
  <div class="wrap wide">
    <a class="brand" href="/">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="17" height="17" rx="4" stroke="#1F4FB8" stroke-width="1.6"/>
        <path d="M5.8 10.2l2.7 2.7 5.7-5.7" stroke="#1F4FB8" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Lingua Oracle
    </a>
    <nav class="nav">
      <a href="/" aria-current="page">Check</a>
      <a href="/ingredients">Ingredients</a>
      <a href="/history">History</a>
      <a href="/coverage">Coverage</a>
    </nav>
  </div>
</div>

<div class="wrap wide page">
  <div class="report-head">
    <div>
      <a class="back" href="/">&larr; Check another document</a>
      <h1>{{ report.file_name }}</h1>
      <div class="meta">
        <span>{{ regulation_display }} &middot; {{ language_name }}</span>
        {% if report.composition == 'substance' %}<span>Substance (Section 3)</span>
        {% elif report.composition == 'mixture' %}<span>Mixture (Section 3)</span>{% endif %}
        {% set read_as = {'gas': 'a gas', 'liquid': 'a liquid', 'solid': 'a solid',
                          'solid/liquid': 'a solid or liquid'} %}
        {% if report.physical_state %}<span>Read as {{ read_as[report.physical_state] }} (Section 9)</span>{% endif %}
        <span>Checked {{ report.created_at.strftime('%-d %b %Y, %H:%M') }}</span>
        {% if report.compared_with %}<span>compared with {{ report.compared_with }}</span>{% endif %}
      </div>
    </div>
    <div class="head-actions">
      <button type="button" onclick="window.print()">Download PDF</button>
      <button type="button" class="copy" data-text="">Copy link</button>
    </div>
  </div>

  <section class="verdict v-{{ page.tone }}" aria-label="Verdict">
    <div class="banner">
      <span class="vico" aria-hidden="true">{{ {'fix': '✕', 'check': '!', 'ok': '✓'}[page.tone] }}</span>
      <div>
        <h2>{{ page.release }}</h2>
        <p>{{ page.detail }}</p>
      </div>
    </div>
    <div class="stats">
      <div><div class="n fix">{{ page.stats.must_fix }}</div><div class="l">Must fix</div></div>
      <div><div class="n check">{{ page.stats.to_check }}</div><div class="l">To check</div></div>
      <div><div class="n ok">{{ page.stats.correct }}</div><div class="l">Correct</div></div>
      <div><div class="n">{{ page.stats.sections }} of 16</div><div class="l">SDS sections checked</div></div>
      <div><div class="n">{{ page.stats.codes_percent }}%</div>
           <div class="l">Codes checked ({{ page.stats.codes_checked }} of {{ page.stats.codes_found }})</div></div>
    </div>
  </section>

  <div class="by-section">
    <aside class="navigator" aria-label="SDS sections">
      <div class="sub">SDS sections</div>
      {% for item in page.nav %}
      {% if item.href %}
      <a href="{{ item.href }}" class="nav-{{ item.status }}"><span class="dot d-{{ item.status }}" aria-hidden="true"></span>{{ item.label }}</a>
      {% else %}
      <span class="nav-none"><span class="dot d-none" aria-hidden="true"></span>{{ item.label }}</span>
      {% endif %}
      {% endfor %}
      <p class="aside-note">Lingua checks the sections that carry classification
        and statements. Others are listed but not judged.</p>
    </aside>

    <div class="sections">
      {% if page.actions %}
      <section class="card todo" aria-label="What to do">
        <h2>What to do</h2>
        <ol>
          {% for action in page.actions %}
          {% set where, rest = action.split(': ', 1) %}
          <li><b>{{ where }}:</b> {{ rest }}</li>
          {% endfor %}
        </ol>
      </section>
      {% endif %}

      {% for sec in page.sections %}
      <section id="{{ sec.anchor }}" class="sds-section s-{{ sec.status }}">
        <header>
          <h2>{{ sec.heading }}</h2>
          <div class="pills">
            {% set fixes = sec.count('fix', 'wrong') %}{% set checks = sec.count('check') %}
            {% if fixes %}<span class="pill fix"><span aria-hidden="true">✕</span> {{ fixes }} must fix</span>{% endif %}
            {% if checks %}<span class="pill check"><span aria-hidden="true">!</span> {{ checks }} to check</span>{% endif %}
            {% if not fixes and not checks %}{{ pill(sec.status) }}{% endif %}
          </div>
        </header>

        {% if sec.number == '1' and ing and ing.candidates %}
        {# The rest of the report is incomplete until this is answered. #}
        <form class="picker" method="post" action="/reports/{{ report.id }}/product">
          <h3>Which product is this?</h3>
          <p class="note">{{ ing.candidates|length }} products in ExactSDS could be
            this sheet. The ingredient and mixture checks need to know which.</p>
          <ul class="candidates">
            {% for c in ing.candidates %}
            <li>
              <label>
                <input type="radio" name="product_id" value="{{ c.product_id }}"
                       {% if loop.first %}checked{% endif %}>
                <span class="who">{{ c.name }}</span>
                <span class="muted">id {{ c.product_id }}{% if c.regulation %}
                  &middot; {{ regulation_name(c.regulation) }}{% endif %}</span>
              </label>
            </li>
            {% endfor %}
          </ul>
          <button type="submit" class="primary">Check this product</button>
        </form>
        {% endif %}

        {% if sec.number == '1' and ing and ing.product_id %}
        <p class="intro">Matched to ExactSDS product: <b>{{ ing.product_name }}</b> ({{ ing.product_id }}).
          <a href="/ingredients?q={{ ing.product_name | urlencode }}">Not this product?</a></p>
        {% endif %}
        {% if sec.intro %}<p class="intro">{{ sec.intro }}</p>{% endif %}

        {% if sec.table %}
        <div class="table-box">
          <table class="ingredients">
            <thead><tr><th>Ingredient</th><th>CAS</th><th>%</th>
              <th>{{ 'The app says' if ing and ing.source == 'app' else 'This sheet says' }}</th>
              <th>{{ sec.table.list_heading }}</th><th>Result</th></tr></thead>
            <tbody>
              {% for t in sec.table.rows %}
              <tr class="st-{{ t.row.status }}" data-status="{{ t.row.status }}">
                <td>{{ t.name }}</td><td class="mono cas">{{ t.cas }}</td><td>{{ t.share }}</td>
                <td class="mono">{{ t.sheet }}</td><td class="mono">{{ t.official }}</td>
                <td>{{ pill(t.row.status) }} <span class="val">{{ t.row.text }}</span></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}

        {% for sub in sec.subs %}
        {% if sub.title %}<div class="subhead">{{ sub.title }}</div>{% endif %}
        {% for r in sub.rows %}{{ row(r) }}{% endfor %}
        {% endfor %}
      </section>
      {% endfor %}

      <section class="card skipped" aria-label="Sections not checked">
        <b>Sections 4&ndash;8 and 10&ndash;15</b> &mdash; not checked. They carry no
        classification or statements this tool judges.
      </section>

      {% if report.sources %}
      <section class="card sources-box" aria-label="Sources used">
        <b>Sources used</b>
        {% for line in report.sources %}<span>{{ line }}</span>{% endfor %}
      </section>
      {% endif %}

      <details class="block">
        <summary>Technical details</summary>
        <div class="inner">
          <dl class="tech">
            {% for line in caveats %}<dt>&nbsp;</dt><dd>{{ line }}</dd>{% endfor %}
            <dt>{{ L.META.file }}</dt><dd>{{ report.file_name }}</dd>
            <dt>{{ L.META.regulation }}</dt><dd>{{ regulation_display }}</dd>
            <dt>{{ L.META.language }}</dt><dd>{{ report.language }}</dd>
            <dt>{{ L.META.set_by }}</dt><dd>{{ set_by }}</dd>
            <dt>{{ L.META.id }}</dt><dd>{{ report.id }}</dd>
            {% for note in report.notes %}<dt>&nbsp;</dt><dd>{{ note }}</dd>{% endfor %}
            <dt>Checks that reported</dt>
            <dd>{% for cid in report.findings|map(attribute='check_id')|unique|sort %}{{ cid }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
            {% if provenance %}
            <dt>Where each wording came from</dt>
            <dd>{% for code, detail in provenance %}<b>{{ code }}</b>: {{ detail }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>
            {% endif %}
            {% if ing_anomalies %}
            <dt>Anomalies in the list itself</dt>
            <dd>{% for line in ing_anomalies %}{{ line }}<br>{% endfor %}</dd>
            {% endif %}
            {% if ing and ing.list_title %}
            <dt>Ingredients measured against</dt>
            <dd>{{ ing.list_title }} &mdash;
              {{ 'binding' if ing.list_binding else 'reference only' }}.
              {{ ing.list_authority }}</dd>
            {% endif %}
            {% if report.substance and report.substance.source_ref %}
            <dt>Substance entry</dt><dd>{{ report.substance.source_ref }}</dd>
            {% endif %}
            {% if mixture and mixture.results %}{{ mix.trace(mixture.results) }}{% endif %}
            {% if mixture and mixture.assumptions %}
            <dt>Mixture assumptions</dt>
            <dd>{% for a in mixture.assumptions %}{{ a }}<br>{% endfor %}</dd>
            {% endif %}
            <dt>Source of official text</dt>
            <dd>{% for tier, label in L.SOURCE.items() %}<b>{{ label.word }}</b>: {{ label.help }} {% endfor %}</dd>
          </dl>
        </div>
      </details>
    </div>
  </div>
</div>

<script>
  document.addEventListener('click', function (event) {
    const copy = event.target.closest('button.copy');
    if (!copy) return;
    const text = copy.dataset.text || window.location.href;
    const done = () => {
      const was = copy.textContent;
      copy.textContent = 'Copied';
      setTimeout(() => { copy.textContent = was; }, 1500);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, done);
    } else {
      const area = document.createElement('textarea');
      area.value = text; document.body.appendChild(area); area.select();
      try { document.execCommand('copy'); } catch (e) {}
      area.remove(); done();
    }
  });
</script>
</body>
</html>
