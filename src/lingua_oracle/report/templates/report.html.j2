<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lingua Oracle - {{ report.file_name }}</title>
{# The stylesheet is inlined rather than linked: a saved report is passed
   around as a single file and has to render with no network. #}
<style>{{ app_css }}</style>
</head>
<body>

<div class="topbar">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="17" height="17" rx="4" stroke="#1F4FB8" stroke-width="1.6"/>
        <path d="M5.8 10.2l2.7 2.7 5.7-5.7" stroke="#1F4FB8" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Lingua Oracle
    </a>
    <nav class="nav">
      <a href="/" aria-current="page">Check</a>
      <a href="/history">History</a>
      <a href="/coverage">Coverage</a>
    </nav>
  </div>
</div>

<div class="wrap page">
  <a class="back" href="/">&larr; Check another document</a>

  <div class="report-head">
    <div>
      <h1>{{ report.file_name }}</h1>
      <div class="meta">
        <span>{{ regulation_display }}</span>
        <span>{{ language_name }}</span>
        <span>Regulation {{ set_by }}</span>
        <span>Checked {{ report.created_at.strftime('%-d %b %Y, %H:%M') }}</span>
        {% if report.compared_with %}<span>compared with {{ report.compared_with }}</span>{% endif %}
      </div>
    </div>
    <div class="head-actions">
      <button type="button" onclick="window.print()">Download PDF</button>
      <button type="button" class="copy" data-text="">Copy link</button>
    </div>
  </div>

  <div class="verdict v-{{ verdict.tone }}">
    <div class="banner">
      <span class="vico" aria-hidden="true">{{ verdict.icon }}</span>
      <div>
        <h2>{{ verdict.release }}</h2>
        <p>{{ verdict.detail }}</p>
      </div>
    </div>
    <div class="stats">
      <div><div class="n fix">{{ cards.counts.wrong }}</div><div class="l">Wrong wording</div></div>
      <div><div class="n fix">{{ cards.counts.fix }}</div><div class="l">Fix this</div></div>
      <div><div class="n check">{{ cards.counts.check }}</div><div class="l">Check this</div></div>
      <div><div class="n ok">{{ cards.counts.correct }}</div><div class="l">Correct</div></div>
      <div><div class="n">{{ coverage_percent }}%</div>
           <div class="l">Codes checked ({{ report.coverage.codes_checked }} of {{ report.coverage.codes_found }})</div></div>
    </div>
  </div>

  {% if verdict.actions %}
  <div class="card todo">
    <h2>What to do</h2>
    <ol>
      {% for text, count in verdict.actions %}
      <li>{{ text }}{% if count > 1 %} <span class="muted">({{ count }} places)</span>{% endif %}</li>
      {% endfor %}
    </ol>
  </div>
  {% endif %}

  <div class="issues-head">
    <h2>Issues &middot; {{ cards.problems|length }}</h2>
    <div class="filters" role="group" aria-label="Filter issues">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="must" aria-pressed="false">Must fix</button>
      <button type="button" data-filter="check" aria-pressed="false">To check</button>
    </div>
  </div>

  {% for row in cards.problems %}
  <article class="issue" data-status="{{ row.status }}">
    <header>
      <span class="pill {{ row.label.css }}"><span aria-hidden="true">{{ row.label.icon }}</span> {{ row.label.word }}</span>
      <span class="code">{{ L.code_label(row.v.code if row.v else row.finding.code) or "This document" }}</span>
      {% set sec = (row.v.section if row.v else row.finding.section) %}
      {% set pg = (row.v.page if row.v else row.finding.page) %}
      {% if sec %}<span class="where">{{ L.section_label(sec) }}{% if pg %} &middot; page {{ pg }}{% endif %}</span>{% endif %}
    </header>

    <div class="body{% if row.single %} single{% endif %}">
      <div class="side">
        <h3>Your document</h3>
        <div class="txt">{% if row.v %}{{ row.found_html | safe }}{% else %}{{ row.finding.found or row.finding.message }}{% endif %}</div>
        {% if row.instruction %}<p class="note instruct">{{ row.instruction }}</p>{% endif %}
        {% if row.match_note %}<p class="note">{{ row.match_note }}</p>{% endif %}
        {% if row.v %}{% for value in row.v.fillins %}
        <p class="note" style="color:var(--accent)">You filled in:
          <mark class="fillin">{{ value }}</mark> &mdash; check it fits this product.</p>
        {% endfor %}{% endif %}
      </div>
      {% if not row.single %}
      <div class="side official">
        <header>
          <h3>{{ row.official_heading }}</h3>
          <button type="button" class="copy" data-text="{{ row.v.expected }}">Copy</button>
        </header>
        <div class="txt">{{ row.expected_html | safe }}</div>
      </div>
      {% endif %}
    </div>

    <footer>
      <span>{% if row.v %}{{ row.v.why }}{% endif %}{% if row.action %} {{ row.action }}{% endif %}</span>
      {% if row.v and row.v.source %}<span class="src">Source: {{ row.v.source }}</span>{% endif %}
    </footer>
  </article>
  {% endfor %}

  {% if cards.correct %}
  <details class="block good">
    <summary>{{ cards.correct|length }} statement{{ '' if cards.correct|length == 1 else 's' }} match the official wording</summary>
    <div class="inner">
      <ul class="statements">
        {% for row in cards.correct %}
        <li><span class="code">{{ row.v.code }}</span>
          <span>{{ row.v.found }}{% if row.v.match_note %}
            <em class="note-inline">{{ row.v.match_note }}</em>{% endif %}</span></li>
        {% endfor %}
      </ul>
    </div>
  </details>
  {% endif %}

  <details class="block">
    <summary>Not checked ({{ cards.unchecked|length }}) and technical details</summary>
    <div class="inner">
      {% if cards.unchecked %}
      <ul class="statements">
        {% for row in cards.unchecked %}
        <li><span class="code">{{ row.v.code }}</span><span>{{ row.v.why }}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
      <dl class="tech">
        {% for line in verdict.caveats %}<dt>&nbsp;</dt><dd>{{ line }}</dd>{% endfor %}
        <dt>{{ L.META.file }}</dt><dd>{{ report.file_name }}</dd>
        <dt>{{ L.META.regulation }}</dt><dd>{{ regulation_display }}</dd>
        <dt>{{ L.META.language }}</dt><dd>{{ report.language }}</dd>
        <dt>{{ L.META.set_by }}</dt><dd>{{ set_by }}</dd>
        <dt>{{ L.META.id }}</dt><dd>{{ report.id }}</dd>
        {% for note in report.notes %}<dt>&nbsp;</dt><dd>{{ note }}</dd>{% endfor %}
        <dt>Checks that reported</dt>
        <dd>{% for cid in report.findings|map(attribute='check_id')|unique|sort %}{{ cid }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
        {% if cards.provenance %}
        <dt>Where each wording came from</dt>
        <dd>{% for code, detail in cards.provenance %}<b>{{ code }}</b>: {{ detail }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>
        {% endif %}
        <dt>Source of official text</dt>
        <dd>{% for tier, label in L.SOURCE.items() %}<b>{{ label.word }}</b>: {{ label.help }} {% endfor %}</dd>
      </dl>
    </div>
  </details>
</div>

<script>
  document.addEventListener('click', function (event) {
    const copy = event.target.closest('button.copy');
    if (copy) {
      const text = copy.dataset.text || window.location.href;
      const done = () => {
        const was = copy.textContent;
        copy.textContent = 'Copied';
        setTimeout(() => { copy.textContent = was; }, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, done);
      } else {
        const area = document.createElement('textarea');
        area.value = text; document.body.appendChild(area); area.select();
        try { document.execCommand('copy'); } catch (e) {}
        area.remove(); done();
      }
      return;
    }
    const filter = event.target.closest('.filters button');
    if (!filter) return;
    const want = filter.dataset.filter;
    document.querySelectorAll('.filters button').forEach(b =>
      b.setAttribute('aria-pressed', String(b === filter)));
    document.querySelectorAll('.issue').forEach(card => {
      const status = card.dataset.status;
      const show = want === 'all'
        || (want === 'must' && (status === 'wrong' || status === 'fix'))
        || (want === 'check' && status === 'check');
      card.hidden = !show;
    });
  });
</script>
</body>
</html>
