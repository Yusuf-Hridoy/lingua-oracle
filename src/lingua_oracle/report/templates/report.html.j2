<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lingua Oracle - {{ report.file_name }}</title>
<style>
  :root {
    --bg:#f7f7f8; --card:#fff; --ink:#1b1b1f; --muted:#5f6368; --line:#e2e3e7;
    --fail:#b3261e; --fail-bg:#fdecea; --warn:#8a5a00; --warn-bg:#fff5e0;
    --info:#0b5cad; --info-bg:#e8f1fb; --ok:#1d6b3a; --ok-bg:#e7f5ec;
    --del:#fbd5d0; --ins:#cdebd7;
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
         font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
  .wrap { max-width:1180px; margin:0 auto; padding:24px 20px 60px; }
  h1 { font-size:20px; margin:0 0 4px; }
  h2 { font-size:15px; margin:0; }
  .sub { color:var(--muted); font-size:13px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:10px;
          margin:16px 0; overflow:hidden; }
  .card > header { padding:12px 16px; border-bottom:1px solid var(--line);
                   display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .meta { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
          gap:12px; padding:16px; }
  .meta div { font-size:13px; }
  .meta dt { color:var(--muted); font-size:12px; }
  .meta dd { margin:2px 0 0; font-weight:600; word-break:break-word; }
  .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
           gap:12px; padding:16px; }
  .tile { border:1px solid var(--line); border-radius:8px; padding:12px; text-align:center; }
  .tile .n { font-size:24px; font-weight:700; line-height:1.1; }
  .tile .l { font-size:12px; color:var(--muted); text-transform:uppercase;
             letter-spacing:.04em; }
  .t-fail .n{color:var(--fail)} .t-warn .n{color:var(--warn)}
  .t-info .n{color:var(--info)} .t-ok .n{color:var(--ok)}
  .badge { display:inline-block; font-size:11px; font-weight:700; padding:2px 8px;
           border-radius:999px; text-transform:uppercase; letter-spacing:.03em; }
  /* Severity is icon + word + colour. Colour alone is not a signal: it is
     invisible in greyscale and to a reader with colour vision deficiency. */
  .result { display:inline-flex; align-items:center; gap:6px; font-size:12px;
            font-weight:700; padding:3px 10px 3px 5px; border-radius:999px;
            white-space:nowrap; }
  .result .ico { display:inline-flex; align-items:center; justify-content:center;
                 width:16px; height:16px; border-radius:50%; font-size:11px;
                 line-height:1; font-weight:800; color:#fff; }
  .r-fail{background:var(--fail-bg);color:var(--fail)} .r-fail .ico{background:var(--fail)}
  .r-warn{background:var(--warn-bg);color:var(--warn)} .r-warn .ico{background:var(--warn)}
  .r-info{background:var(--info-bg);color:var(--info)} .r-info .ico{background:var(--info)}
  .r-unver{background:#eceff1;color:#455a64} .r-unver .ico{background:#607d8b}
  .src { display:inline-flex; align-items:center; gap:6px; font-size:12px;
         white-space:nowrap; }
  .src .k { display:inline-flex; align-items:center; justify-content:center;
            width:18px; height:18px; border-radius:50%; font-size:10px;
            font-weight:800; background:#eceff1; color:#37474f; }
  .src-A .k{background:var(--ok-bg);color:var(--ok)}
  .src-B .k{background:var(--info-bg);color:var(--info)}
  .src-C .k{background:#eceff1;color:#546e7a}
  .verdict { border-radius:10px; padding:18px 20px; margin:16px 0;
             border:1px solid var(--line); background:var(--card); }
  .verdict .head { display:flex; gap:12px; align-items:flex-start; }
  .verdict .vico { flex:0 0 auto; width:28px; height:28px; border-radius:50%;
                   display:flex; align-items:center; justify-content:center;
                   color:#fff; font-weight:800; font-size:15px; }
  .verdict h2 { font-size:18px; line-height:1.3; }
  .verdict .detail { color:var(--muted); font-size:13px; margin-top:3px; }
  .v-ok{background:var(--ok-bg);border-color:#bfe3cc}   .v-ok .vico{background:var(--ok)}
  .v-warn{background:var(--warn-bg);border-color:#efdcb0} .v-warn .vico{background:var(--warn)}
  .v-bad{background:var(--fail-bg);border-color:#f3c9c4}  .v-bad .vico{background:var(--fail)}
  .caveats { margin:14px 0 0; padding:12px 14px; background:rgba(255,255,255,.65);
             border:1px solid var(--line); border-radius:8px; }
  .caveats .t { font-size:11px; font-weight:700; text-transform:uppercase;
                letter-spacing:.05em; color:var(--muted); margin-bottom:6px; }
  .caveats ul { margin:0; padding-left:18px; }
  .caveats li { font-size:12.5px; color:var(--ink); margin:3px 0; }
  .cid { font-size:12px; color:var(--muted); font-weight:500; }
  .verdict .release { font-size:13px; font-weight:800; letter-spacing:.09em;
                      text-transform:uppercase; margin-bottom:2px; }
  .todo { margin:14px 0 0; padding:12px 14px 12px 16px; background:#fff;
          border:1px solid var(--line); border-radius:8px; }
  .todo .t { font-size:11px; font-weight:700; text-transform:uppercase;
             letter-spacing:.05em; color:var(--muted); margin-bottom:6px; }
  .todo ol { margin:0; padding-left:20px; }
  .todo li { font-size:13.5px; margin:4px 0; }
  .todo .times { color:var(--muted); font-size:12px; }
  .todo-line { margin-top:4px; font-size:12px; color:#1b5e20; }
  details.tech { margin-top:22px; border:1px solid var(--line); border-radius:10px;
                 background:var(--card); }
  details.tech > summary { cursor:pointer; padding:11px 16px; font-size:13px;
                           color:var(--muted); font-weight:600; }
  details.tech .body { padding:0 16px 14px; font-size:12px; color:var(--muted); }
  details.tech dl { display:grid; grid-template-columns:200px 1fr; gap:4px 14px;
                    margin:0; }
  details.tech dt { font-weight:600; }
  .b-fail{background:var(--fail-bg);color:var(--fail)}
  .b-warn{background:var(--warn-bg);color:var(--warn)}
  .b-info{background:var(--info-bg);color:var(--info)}
  .b-unver{background:#eceff1;color:#455a64}
  .tier { display:inline-block; width:20px; height:20px; line-height:20px;
          text-align:center; border-radius:50%; font-size:11px; font-weight:700;
          background:#eceff1; color:#37474f; }
  .tier-A{background:var(--ok-bg);color:var(--ok)}
  .tier-B{background:var(--info-bg);color:var(--info)}
  .tier-C{background:#eceff1;color:#546e7a}
  .scroll { overflow-x:auto; }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th,td { text-align:left; padding:9px 12px; border-top:1px solid var(--line);
          vertical-align:top; }
  th { background:#fafafb; font-size:12px; color:var(--muted); font-weight:600;
       border-top:none; white-space:nowrap; }
  td.code { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; white-space:nowrap; }
  .txt { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px;
         line-height:1.55; word-break:break-word; max-width:420px; }
  /* Only the differing words are marked, in both columns. Nothing is struck
     through: the official wording is not wrong, and showing it crossed out
     said the opposite of what that column means. */
  mark.diff { background:#fff3a3; border-radius:3px; padding:0 1px; }
  .msg { color:var(--muted); font-size:12px; margin-top:4px; }
  .notes { padding:12px 16px; font-size:12px; color:var(--muted); }
  .notes li { margin:3px 0; }
  .empty { padding:24px 16px; color:var(--muted); }
  .count { font-size:12px; color:var(--muted); margin-left:auto; }
</style>
</head>
<body>
<div class="wrap">

  <h1>Lingua Oracle report</h1>
  <div class="sub">{{ report.file_name }}{% if report.compared_with %} &middot; compared with {{ report.compared_with }}{% endif %}</div>

  <div class="verdict v-{{ verdict.tone }}" role="status" id="verdict">
    <div class="head">
      <span class="vico" aria-hidden="true">{{ verdict.icon }}</span>
      <div>
        <div class="release">{{ verdict.release }}</div>
        <h2>{{ verdict.headline }}</h2>
        <div class="detail">{{ verdict.detail }}</div>
      </div>
    </div>
    {% if verdict.actions %}
    <div class="todo">
      <div class="t">What to do</div>
      <ol>
        {% for text, count in verdict.actions %}
        <li>{{ text }}{% if count > 1 %} <span class="times">({{ count }} places)</span>{% endif %}</li>
        {% endfor %}
      </ol>
    </div>
    {% endif %}
    <div class="caveats">
      <div class="t">What this does not tell you</div>
      <ul>
        {% for line in verdict.caveats %}<li>{{ line }}</li>{% endfor %}
      </ul>
    </div>
  </div>

  <div class="card">
    <dl class="meta">
      <div><dt>{{ L.META.file }}</dt><dd>{{ report.file_name }}</dd></div>
      <div><dt>{{ L.META.regulation }}</dt><dd>{{ regulation_display }}</dd></div>
      <div><dt>{{ L.META.language }}</dt><dd>{{ report.language }}</dd></div>
      <div><dt>{{ L.META.set_by }}</dt><dd>{{ set_by }}</dd></div>

    </dl>
  </div>

  <div class="card">
    <header><h2>Summary</h2></header>
    <div class="tiles">
      <div class="tile t-fail"><div class="n">{{ report.summary.fail }}</div><div class="l">{{ L.TILES.fail }}</div></div>
      <div class="tile t-warn"><div class="n">{{ report.summary.warn }}</div><div class="l">{{ L.TILES.warn }}</div></div>
      <div class="tile t-info"><div class="n">{{ report.summary.info }}</div><div class="l">{{ L.TILES.info }}</div></div>
      <div class="tile"><div class="n">{{ report.summary.unverified }}</div><div class="l">{{ L.TILES.unverified }}</div></div>
      <div class="tile t-ok"><div class="n">{{ coverage_percent }}%</div><div class="l">{{ L.TILES.coverage }}</div></div>
      <div class="tile"><div class="n">{{ report.coverage.codes_found }}</div><div class="l">{{ L.TILES.codes }}</div></div>
    </div>
    {% if report.notes %}
    {% endif %}
  </div>

  {% if not groups %}
    <div class="card"><div class="empty">No findings. Every code in this document matched its official wording.</div></div>
  {% endif %}

  {% for group in groups %}
  <div class="card">
    <header>
      <h2>{{ group.title }} <span class="cid">(check {{ group.check_id }})</span></h2>
      {% if group.fails %}<span class="result r-fail"><span class="ico" aria-hidden="true">{{ L.SEVERITY[SEV.FAIL].icon }}</span>{{ group.fails }} {{ L.SEVERITY[SEV.FAIL].word|lower }}</span>{% endif %}
      {% if group.warns %}<span class="result r-warn"><span class="ico" aria-hidden="true">{{ L.SEVERITY[SEV.WARN].icon }}</span>{{ group.warns }} to check</span>{% endif %}
      {% if group.unverified %}<span class="result r-unver"><span class="ico" aria-hidden="true">{{ L.NOT_CHECKED.icon }}</span>{{ group.unverified }} not checked</span>{% endif %}
      <span class="count">{{ group.rows|length }} finding{{ '' if group.rows|length == 1 else 's' }}</span>
    </header>
    <div class="scroll">
    <table>
      <thead><tr>
        <th>{{ L.COLUMNS.severity }}</th><th>{{ L.COLUMNS.section }}</th>
        <th>{{ L.COLUMNS.page }}</th><th>{{ L.COLUMNS.code }}</th>
        <th>{{ L.COLUMNS.tier }}</th><th>{{ group.expected_column }}</th>
        <th>{{ L.COLUMNS.found }}</th>
      </tr></thead>
      <tbody>
      {% for row in group.rows %}
        {% set f = row.finding %}
        <tr>
          <td>
            <span class="result r-{{ row.result.css }}" title="{{ row.result.help }}">
              <span class="ico" aria-hidden="true">{{ row.result.icon }}</span>{{ row.result.word }}
            </span>
          </td>
          <td>{{ row.section_label or '—' }}</td>
          <td>{{ f.page if f.page is not none else '' }}</td>
          <td class="code">{{ row.code_label }}</td>
          <td>{% if row.source %}<span class="src src-{{ row.source.css }}" title="{{ row.source.help }}"><span class="k" aria-hidden="true">{{ row.source.icon }}</span>{{ row.source.word }}</span>{% endif %}</td>
          <td class="txt">{{ row.expected_html | safe }}</td>
          <td class="txt">
            {{ row.found_html | safe }}
            {% if f.message %}<div class="msg">{{ f.message }}</div>{% endif %}
            {% if row.action %}<div class="todo-line">&rarr; {{ row.action }}</div>{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>
  {% endfor %}

  <details class="tech">
    <summary>Technical details</summary>
    <div class="body">
      <dl>
        <dt>{{ L.META.created }}</dt><dd>{{ report.created_at.strftime('%Y-%m-%d %H:%M UTC') }}</dd>
        <dt>{{ L.META.id }}</dt><dd>{{ report.id }}</dd>
        {% for note in report.notes %}
        <dt>&nbsp;</dt><dd>{{ note }}</dd>
        {% endfor %}
      </dl>
    </div>
  </details>

  <div class="sub" style="margin-top:20px">
    <b>Source of official text</b> &mdash;
    {% for tier, label in L.SOURCE.items() %}
      <b>{{ label.word }}</b>: {{ label.help }}{% if not loop.last %} &middot; {% endif %}
    {% endfor %}
  </div>
</div>
</body>
</html>
