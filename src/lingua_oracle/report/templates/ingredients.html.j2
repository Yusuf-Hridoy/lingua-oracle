{% import '_substances.html.j2' as cards %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lingua Oracle &ndash; ingredient check</title>
{# Inlined, like the wording report: a saved run is passed around as one file
   and has to render with no network. #}
<style>{{ app_css }}</style>
</head>
<body>

{% if nav %}
<div class="topbar">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="17" height="17" rx="4" stroke="#1F4FB8" stroke-width="1.6"/>
        <path d="M5.8 10.2l2.7 2.7 5.7-5.7" stroke="#1F4FB8" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Lingua Oracle
    </a>
    <nav class="nav">
      <a href="/">Check</a>
      <a href="/ingredients" aria-current="page">Ingredients</a>
      <a href="/history">History</a>
      <a href="/coverage">Coverage</a>
    </nav>
  </div>
</div>
{% endif %}

<div class="wrap page">
  {% if nav %}<a class="back" href="/ingredients">&larr; Run another check</a>{% endif %}

  <div class="report-head">
    <div>
      <h1>Ingredient check</h1>
      <div class="meta">
        <span>against CLP Annex VI Table 3</span>
        <span>{{ run.annex_vi_source }}</span>
        <span>{{ run.started_at[:16].replace('T', ' ') }}</span>
      </div>
    </div>
  </div>

  <div class="verdict v-{{ tone }}">
    <div class="banner">
      <span class="vico" aria-hidden="true">{{ icon }}</span>
      <div><h2>{{ release }}</h2><p>{{ detail }}</p></div>
    </div>
    <div class="stats">
      <div><div class="n fix">{{ counts.fix }}</div><div class="l">Under-classified</div></div>
      <div><div class="n check">{{ counts.inconsistent_substances }}</div><div class="l">Inconsistent codes</div></div>
      <div><div class="n ok">{{ counts.ok }}</div><div class="l">Matches Annex VI</div></div>
      <div><div class="n">{{ counts.not_checked }}</div><div class="l">Not checked</div></div>
      <div><div class="n">{{ counts.substances }}</div>
           <div class="l">Substances ({{ counts.uses }} uses in {{ counts.products }} products)</div></div>
    </div>
  </div>

  {% if under %}
  <div class="issues-head"><h2>Under-classified &middot; {{ under|length }}</h2></div>
  {% for s in under %}{{ cards.under_card(s) }}{% endfor %}
  {% endif %}

  {% if inconsistent %}
  <div class="issues-head"><h2>Same substance, different codes &middot; {{ inconsistent|length }}</h2></div>
  {% for s in inconsistent %}{{ cards.inconsistent_card(s) }}{% endfor %}
  {% endif %}

  {{ cards.upcoming(run.substances or []) }}
  {{ cards.collapsed(matches, extra, unchecked, reasons) }}

  <details class="block">
    <summary>Technical details</summary>
    <div class="inner"><dl class="tech">
      {% if run.sources %}
      <dt>Sources used</dt>
      <dd class="sources">{% for line in run.sources %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>
      {% else %}
      <dt>Annex VI source</dt><dd>{{ run.annex_vi_source }}</dd>
      {% endif %}
      <dt>Run at</dt><dd>{{ run.started_at }}</dd>
      <dt>Products read</dt><dd>{{ counts.products }}</dd>
      <dt>Substances checked</dt><dd>{{ counts.substances }}</dd>
      <dt>Product uses checked</dt><dd>{{ counts.uses }}</dd>
      <dt>Under-classified uses</dt><dd>{{ counts.uses_under_classified }}</dd>
      <dt>Missing codes, by use</dt>
      <dd>{% for code, n in run.missing_code_patterns %}{{ code }}: {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
      <dt>Missing codes, by substance</dt>
      <dd>{% for code, n in run.missing_code_by_substance %}{{ code }}: {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
      <dt>Not checked, by reason</dt>
      <dd>{% for reason, n in run.not_checked_reasons.items() %}{{ reasons[reason] or reason }}: {{ n }}{% if not loop.last %}; {% endif %}{% endfor %}</dd>
      <dt>Substance data sources, as the app reports them</dt>
      <dd>{% for source, n in run.data_sources.items() %}{{ source }}: {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
    </dl></div>
  </details>
</div>
</body>
</html>
