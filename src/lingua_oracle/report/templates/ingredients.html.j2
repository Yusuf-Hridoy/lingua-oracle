<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lingua Oracle &ndash; ingredient check</title>
{# Inlined, like the wording report: a saved run is passed around as one file
   and has to render with no network. #}
<style>{{ app_css }}</style>
</head>
<body>

{% if nav %}
<div class="topbar">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="17" height="17" rx="4" stroke="#1F4FB8" stroke-width="1.6"/>
        <path d="M5.8 10.2l2.7 2.7 5.7-5.7" stroke="#1F4FB8" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Lingua Oracle
    </a>
    <nav class="nav">
      <a href="/">Check</a>
      <a href="/ingredients" aria-current="page">Ingredients</a>
      <a href="/history">History</a>
      <a href="/coverage">Coverage</a>
    </nav>
  </div>
</div>
{% endif %}

<div class="wrap page">
  {% if nav %}<a class="back" href="/ingredients">&larr; Run another check</a>{% endif %}

  <div class="report-head">
    <div>
      <h1>Ingredient check</h1>
      <div class="meta">
        <span>against CLP Annex VI Table 3</span>
        <span>{{ run.annex_vi_source }}</span>
        <span>{{ run.started_at[:16].replace('T', ' ') }}</span>
      </div>
    </div>
  </div>

  <div class="verdict v-{{ tone }}">
    <div class="banner">
      <span class="vico" aria-hidden="true">{{ icon }}</span>
      <div><h2>{{ release }}</h2><p>{{ detail }}</p></div>
    </div>
    <div class="stats">
      <div><div class="n fix">{{ counts.fix }}</div><div class="l">Under-classified</div></div>
      <div><div class="n check">{{ counts.inconsistent_substances }}</div><div class="l">Inconsistent codes</div></div>
      <div><div class="n ok">{{ counts.ok }}</div><div class="l">Matches Annex VI</div></div>
      <div><div class="n">{{ counts.not_checked }}</div><div class="l">Not checked</div></div>
      <div><div class="n">{{ counts.substances }}</div>
           <div class="l">Substances ({{ counts.uses }} uses in {{ counts.products }} products)</div></div>
    </div>
  </div>

  {% if under %}
  <div class="issues-head"><h2>Under-classified &middot; {{ under|length }}</h2></div>
  {% for s in under %}
  <article class="issue" data-status="fix" data-cas="{{ s.cas }}">
    <header>
      <span class="pill fix"><span aria-hidden="true">&#10005;</span> Fix this</span>
      <span class="code">{{ s.cas }}</span>
      <span class="where">{{ s.name or 'unnamed' }} &middot;
        {{ s.uses_under_classified }} of {{ s.uses_checked }} uses</span>
    </header>
    <div class="body">
      <div class="side">
        <h3>The app says</h3>
        <div class="txt">{{ s.code_sets | map(attribute='codes') | map('join', ', ')
                             | reject('equalto', '') | unique | join(' &middot; ') | safe
                             or '(no codes)' }}</div>
        <p class="note">Missing:
          {% for code, n in s.missing_code_counts.items() %}<mark class="fillin">{{ code }}</mark>
          in {{ n }} use{{ '' if n == 1 else 's' }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
      </div>
      <div class="side official">
        <header><h3>Annex VI requires</h3></header>
        <div class="txt">{{ s.harmonised_codes | join(', ') }}</div>
      </div>
    </div>
    <details class="affected">
      <summary>{{ s.affected_products|length }} affected product{{ '' if s.affected_products|length == 1 else 's' }}</summary>
      <div class="inner"><p class="mono ids">{{ s.affected_products | join(', ') }}</p></div>
    </details>
    <footer>
      <span class="src">Source: {{ s.source_ref }}</span>
    </footer>
  </article>
  {% endfor %}
  {% endif %}

  {% if inconsistent %}
  <div class="issues-head"><h2>Same substance, different codes &middot; {{ inconsistent|length }}</h2></div>
  {% for s in inconsistent %}
  <article class="issue" data-status="check" data-cas="{{ s.cas }}">
    <header>
      <span class="pill check"><span aria-hidden="true">!</span> Check this</span>
      <span class="code">{{ s.cas }}</span>
      <span class="where">{{ s.name or 'unnamed' }} &middot;
        {{ s.distinct_code_sets }} different code sets</span>
    </header>
    <div class="body single">
      <div class="side">
        <h3>What the products say</h3>
        <table class="minor-table">
          <thead><tr><th>Products</th><th>H codes</th><th>Against Annex VI</th></tr></thead>
          <tbody>
            {% for cs in s.code_sets %}
            <tr>
              <td class="code">{{ cs.count }}</td>
              <td>{{ cs.codes | join(', ') or '(none)' }}</td>
              <td>{% if cs.missing %}missing {{ cs.missing | join(', ') }}
                  {% else %}carries everything Annex VI requires{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    <details class="affected">
      <summary>Product IDs by code set</summary>
      <div class="inner">
        {% for cs in s.code_sets %}
        <p class="mono ids"><b>{{ cs.codes | join(', ') or '(none)' }}</b>:
          {{ cs.products | join(', ') }}</p>
        {% endfor %}
      </div>
    </details>
    <footer><span class="src">Source: {{ s.source_ref or 'no harmonised entry' }}</span></footer>
  </article>
  {% endfor %}
  {% endif %}

  {% if matches %}
  <details class="block good">
    <summary>{{ matches|length }} substance{{ '' if matches|length == 1 else 's' }}
      {{ 'matches' if matches|length == 1 else 'match' }} Annex VI</summary>
    <div class="inner"><ul class="statements">
      {% for s in matches %}
      <li><span class="code">{{ s.cas }}</span>
        <span>{{ s.name or 'unnamed' }} &mdash; {{ s.uses_checked }} use{{ '' if s.uses_checked == 1 else 's' }},
          carries {{ s.harmonised_codes | join(', ') }}</span></li>
      {% endfor %}
    </ul></div>
  </details>
  {% endif %}

  {% if extra %}
  <details class="block">
    <summary>{{ extra|length }} substance{{ '' if extra|length == 1 else 's' }}
      {{ 'adds' if extra|length == 1 else 'add' }} classes Annex VI does not cover</summary>
    <div class="inner">
      <p class="note">Ordinary: the harmonised entry is a floor, and a supplier
        classifies for the hazards it leaves to them.</p>
      <ul class="statements">
        {% for s in extra %}
        <li><span class="code">{{ s.cas }}</span><span>{{ s.name or 'unnamed' }}</span></li>
        {% endfor %}
      </ul>
    </div>
  </details>
  {% endif %}

  {% if unchecked %}
  <details class="block">
    <summary>{{ unchecked|length }} substance{{ '' if unchecked|length == 1 else 's' }}
      not checked</summary>
    <div class="inner"><ul class="statements">
      {% for s in unchecked %}
      <li><span class="code">{{ s.cas }}</span>
        <span>{{ s.name or 'unnamed' }} &mdash; {{ reasons[s.reason] or s.reason }}</span></li>
      {% endfor %}
    </ul></div>
  </details>
  {% endif %}

  <details class="block">
    <summary>Technical details</summary>
    <div class="inner"><dl class="tech">
      <dt>Annex VI source</dt><dd>{{ run.annex_vi_source }}</dd>
      <dt>Run at</dt><dd>{{ run.started_at }}</dd>
      <dt>Products read</dt><dd>{{ counts.products }}</dd>
      <dt>Substances checked</dt><dd>{{ counts.substances }}</dd>
      <dt>Product uses checked</dt><dd>{{ counts.uses }}</dd>
      <dt>Under-classified uses</dt><dd>{{ counts.uses_under_classified }}</dd>
      <dt>Missing codes, by use</dt>
      <dd>{% for code, n in run.missing_code_patterns %}{{ code }}: {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
      <dt>Missing codes, by substance</dt>
      <dd>{% for code, n in run.missing_code_by_substance %}{{ code }}: {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
      <dt>Not checked, by reason</dt>
      <dd>{% for reason, n in run.not_checked_reasons.items() %}{{ reasons[reason] or reason }}: {{ n }}{% if not loop.last %}; {% endif %}{% endfor %}</dd>
      <dt>Substance data sources, as the app reports them</dt>
      <dd>{% for source, n in run.data_sources.items() %}{{ source }}: {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
    </dl></div>
  </details>
</div>
</body>
</html>
