{# Substance cards, shared by the ingredient report and the Ingredients section
   of a wording report. One definition, so the two cannot drift apart. #}

{# `listing` is which published list this was judged against and whether the
   regulation makes it binding. A difference from a binding list is a fault;
   a difference from somebody else's list is worth checking and nothing more,
   and the card has to say which of the two it is showing. #}
{% macro under_card(s, said_by='The app says', listing=None) %}
{% set binding = listing is none or listing.binding %}
{% set title = listing.title if listing else 'Annex VI' %}
<article class="issue" data-status="{{ 'fix' if binding else 'check' }}"
         data-cas="{{ s.cas }}">
  <header>
    {% if binding %}
    <span class="pill fix"><span aria-hidden="true">&#10005;</span> Fix this</span>
    {% else %}
    <span class="pill check"><span aria-hidden="true">!</span> Check this</span>
    {% endif %}
    <span class="code">{{ s.cas }}</span>
    <span class="where">{{ s.name or 'unnamed' }} &middot;
      {{ s.uses_under_classified }} of {{ s.uses_checked }} uses</span>
  </header>
  <div class="body">
    <div class="side">
      <h3>{{ said_by }}</h3>
      <div class="txt">{{ s.code_sets | map(attribute='codes') | map('join', ', ')
                           | reject('equalto', '') | unique | join(' · ')
                           or '(no codes)' }}</div>
      <p class="note">Missing:
        {% for code, n in s.missing_code_counts.items() %}<mark class="fillin">{{ code }}</mark>
        in {{ n }} use{{ '' if n == 1 else 's' }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
    </div>
    <div class="side official">
      <header><h3>{{ title }} {{ 'requires' if binding else 'lists' }}</h3></header>
      <div class="txt">{{ s.harmonised_codes | join(', ') }}</div>
      {% if not binding %}
      <p class="note">{{ title }} lists
        {{ s.missing_code_counts.keys() | join(', ') }};
        {{ listing.regulation_name }} has no binding list.</p>
      {% endif %}
    </div>
  </div>
  {% if s.affected_products %}
  <details class="affected">
    <summary>{{ s.affected_products|length }} affected
      {{ 'product' if s.affected_products|length == 1 else 'products' }}</summary>
    <div class="inner"><p class="mono ids">{{ s.affected_products | join(', ') }}</p></div>
  </details>
  {% endif %}
  <footer><span class="src">Source: {{ s.source_ref }}</span></footer>
</article>
{% endmacro %}

{% macro inconsistent_card(s, said_by='What the products say') %}
<article class="issue" data-status="check" data-cas="{{ s.cas }}">
  <header>
    <span class="pill check"><span aria-hidden="true">!</span> Check this</span>
    <span class="code">{{ s.cas }}</span>
    <span class="where">{{ s.name or 'unnamed' }} &middot;
      {{ s.distinct_code_sets }} different code sets</span>
  </header>
  <div class="body single">
    <div class="side">
      <h3>{{ said_by }}</h3>
      <table class="minor-table">
        <thead><tr><th>Products</th><th>H codes</th><th>Against Annex VI</th></tr></thead>
        <tbody>
          {% for cs in s.code_sets %}
          <tr>
            <td class="code">{{ cs.count }}</td>
            <td>{{ cs.codes | join(', ') or '(none)' }}</td>
            <td>{% if cs.missing %}missing {{ cs.missing | join(', ') }}
                {% else %}carries everything Annex VI requires{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  <details class="affected">
    <summary>Product IDs by code set</summary>
    <div class="inner">
      {% for cs in s.code_sets %}
      <p class="mono ids"><b>{{ cs.codes | join(', ') or '(none)' }}</b>:
        {{ cs.products | join(', ') }}</p>
      {% endfor %}
    </div>
  </details>
  <footer><span class="src">Source: {{ s.source_ref or 'no harmonised entry' }}</span></footer>
</article>
{% endmacro %}

{% macro collapsed(matches, extra, unchecked, reasons) %}
{% if matches %}
<details class="block good">
  <summary>{{ matches|length }} substance{{ '' if matches|length == 1 else 's' }}
    {{ 'matches' if matches|length == 1 else 'match' }} Annex VI</summary>
  <div class="inner"><ul class="statements">
    {% for s in matches %}
    <li><span class="code">{{ s.cas }}</span>
      <span>{{ s.name or 'unnamed' }} &mdash; carries {{ s.harmonised_codes | join(', ') }}</span></li>
    {% endfor %}
  </ul></div>
</details>
{% endif %}
{% if extra %}
<details class="block">
  <summary>{{ extra|length }} substance{{ '' if extra|length == 1 else 's' }}
    {{ 'adds' if extra|length == 1 else 'add' }} classes Annex VI does not cover</summary>
  <div class="inner">
    <p class="note">Ordinary: the harmonised entry is a floor, and a supplier
      classifies for the hazards it leaves to them.</p>
    <ul class="statements">
      {% for s in extra %}
      <li><span class="code">{{ s.cas }}</span><span>{{ s.name or 'unnamed' }}</span></li>
      {% endfor %}
    </ul>
  </div>
</details>
{% endif %}
{% if unchecked %}
<details class="block">
  <summary>{{ unchecked|length }} substance{{ '' if unchecked|length == 1 else 's' }}
    not checked</summary>
  <div class="inner"><ul class="statements">
    {% for s in unchecked %}
    <li><span class="code">{{ s.cas }}</span>
      <span>{{ s.name or 'unnamed' }} &mdash; {{ reasons[s.reason] or s.reason }}</span></li>
    {% endfor %}
  </ul></div>
</details>
{% endif %}
{% endmacro %}
