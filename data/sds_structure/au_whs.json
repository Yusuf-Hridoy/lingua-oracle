 "items": [
  {
   "id": "date_reviewed",
   "kind": "date",
   "scope": "document",
   "rule": {
    "binding": true,
    "quote": "(1) A safety data sheet for a hazardous chemical must: (b) state the date it was last reviewed or, if it has not been reviewed, the date it was prepared;",
    "citation": "Model Work Health and Safety Regulations as at 5 December 2025 (Safe Work Australia), Schedule 7, clause 1(1)(b), page 448"
   }
  },
  {
   "id": "supplier_telephone",
   "kind": "telephone",
   "scope": "document",
   "rule": {
    "binding": true,
    "quote": "(1) A safety data sheet for a hazardous chemical must: (c) state the name, and the Australian address and business telephone number of: (i) the manufacturer; or (ii) the importer;",
    "citation": "Model Work Health and Safety Regulations as at 5 December 2025 (Safe Work Australia), Schedule 7, clause 1(1)(c), page 448"
   }
  },
  {
   "id": "emergency_telephone",
   "kind": "emergency_telephone",
   "scope": "document",
   "rule": {
    "binding": true,
    "quote": "(1) A safety data sheet for a hazardous chemical must: (d) state an Australian business telephone number from which information about the chemical can be obtained in an emergency;",
    "citation": "Model Work Health and Safety Regulations as at 5 December 2025 (Safe Work Australia), Schedule 7, clause 1(1)(d), page 448"
   }
  }
