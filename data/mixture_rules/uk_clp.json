    "aquatic_acute": {
      "Aquatic Acute 1": [
        {
          "amount": "25",
          "raw": "[F50Classification of a mixture for short-term (acute) hazards based on summation of classified components] Sum of components classified as: Mixture is classified as: Ma Acute 1 Acute 1 × ≥ 25 %",
          "source": {
            "document": "Regulation (EC) No 1272/2008 as retained in GB law",
            "section": "Annex I, Table 4.1.1",
            "page": 219
          }
        }
      ]
    },
    "aquatic_chronic": {
      "Aquatic Chronic 1": [
        {
          "amount": "25",
          "raw": "[F50Classification of a mixture for long-term (chronic) hazards, based on summation of the concentration of classified components] Sum of components classified as: Mixture is classified as: Ma Chronic 1 Chronic 1 × ≥ 25 %",
          "source": {
            "document": "Regulation (EC) No 1272/2008 as retained in GB law",
            "section": "Annex I, Table 4.1.2",
            "page": 220
          }
        }
      ],
      "Aquatic Chronic 1 into 2": [
        {
          "amount": "10",
          "raw": "(M × 10 × Chronic 1) + Chronic 2 ≥ 25 % Chronic 2",
          "source": {
            "document": "Regulation (EC) No 1272/2008 as retained in GB law",
            "section": "Annex I, Table 4.1.2",
            "page": 220
          }
        }
      ],
