        {
          "amount": "100",
          "raw": "(M × 100 × Chronic 1) + (10 × Chronic 2) + Chronic 3 Chronic 3 ≥ 25 %",
          "source": {
            "document": "Regulation (EC) No 1272/2008 as retained in GB law",
            "section": "Annex I, Table 4.1.2",
            "page": 220
          }
        }
      ],
